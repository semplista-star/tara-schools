generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  ADMIN
  TUTOR
  WELLBEING_REFERENT
  SUPERADMIN
}

enum ConsentStatus {
  PENDING
  GRANTED
  DENIED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

// Un centro educativo. Todo el resto de datos queda aislado por schoolId:
// ningún usuario de un centro puede ver datos de otro centro.
// Excepción: existe una fila ancla (nombre "Tara — Panel central") que no
// es un centro real, solo el FK obligatorio de los StaffUser con rol
// SUPERADMIN — su acceso ignora el aislamiento por schoolId a nivel de
// aplicación (ver /control), no a nivel de base de datos.
model School {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  groups       Group[]
  students     Student[]
  staff        StaffUser[]
  safetyAlerts SafetyAlert[]
  auditLogs    AuditLog[]
}

// Un grupo/clase dentro de un centro. Un tutor puede tener varios grupos.
model Group {
  id        String   @id @default(cuid())
  name      String
  schoolId  String
  createdAt DateTime @default(now())

  school   School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students Student[]
  tutors   StaffUser[] @relation("TutorGroups")

  @@unique([schoolId, name])
}

// Personal del centro con acceso al panel. El rol determina qué puede ver:
// ADMIN: agregados de todo el centro. TUTOR: solo sus grupos asignados.
// WELLBEING_REFERENT: alertas de seguridad de todo el centro.
model StaffUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         StaffRole
  schoolId     String
  createdAt    DateTime  @default(now())

  school                     School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tutorGroups                Group[]                 @relation("TutorGroups")
  assignedSafetyAlerts       SafetyAlert[]           @relation("AssignedReferent")
  safetyAlertNotes           SafetyAlertNote[]
  auditLogs                  AuditLog[]
  assignedPublicSafetyAlerts PublicSafetyAlert[]     @relation("AssignedPublicAlert")
  publicSafetyAlertNotes     PublicSafetyAlertNote[] @relation("PublicAlertNoteAuthor")
}

// Alumno/a representado únicamente por un alias pseudónimo. Nunca se
// almacena aquí (ni en ningún otro modelo) el texto literal de sus
// conversaciones con Tara: solo datos agregados y anonimizados.
model Student {
  id            String        @id @default(cuid())
  alias         String
  schoolId      String
  groupId       String
  consentStatus ConsentStatus @default(PENDING)
  guardianEmail String? // correo de contacto de la familia, para recordatorios de consentimiento
  createdAt     DateTime      @default(now())

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  group             Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  usageSummaries    UsageSummary[]
  humanBridgeEvents HumanBridgeEvent[]
  safetyAlerts      SafetyAlert[]

  @@unique([groupId, alias])
}

// Resumen de uso agregado por periodo (p.ej. semanal). Nunca contiene texto
// de conversación: solo contadores y categorías anonimizadas.
model UsageSummary {
  id            String   @id @default(cuid())
  studentId     String
  periodStart   DateTime
  periodEnd     DateTime
  sessionsCount Int      @default(0)
  totalMinutes  Int      @default(0)
  topics        Json? // recuento agregado por categoría, p.ej. {"estudios": 3, "amistad": 2}
  moodTrend     String? // etiqueta cualitativa agregada: "estable" | "mejora" | "empeora"
  createdAt     DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, periodStart])
}

// Evento en que Tara activó un "puente humano" (recomendó hablar con un
// adulto). Solo guarda una categoría anonimizada del motivo, nunca el texto.
model HumanBridgeEvent {
  id          String   @id @default(cuid())
  studentId   String
  triggeredAt DateTime @default(now())
  category    String
  resolved    Boolean  @default(false)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// Alerta de seguridad. Visible únicamente para el rol WELLBEING_REFERENT
// (y ADMIN de forma agregada, sin detalle individual). El campo "summary"
// es una descripción profesional generada por el sistema, no una cita
// literal de la conversación del/de la menor.
model SafetyAlert {
  id                 String         @id @default(cuid())
  studentId          String
  schoolId           String
  severity           AlertSeverity
  status             AlertStatus    @default(OPEN)
  summary            String
  assignedReferentId String?
  createdAt          DateTime       @default(now())
  resolvedAt         DateTime?

  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignedReferent StaffUser?        @relation("AssignedReferent", fields: [assignedReferentId], references: [id])
  notes            SafetyAlertNote[]

  @@index([schoolId, status])
}

model SafetyAlertNote {
  id        String   @id @default(cuid())
  alertId   String
  authorId  String
  text      String
  createdAt DateTime @default(now())

  alert  SafetyAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  author StaffUser   @relation(fields: [authorId], references: [id])
}

// Registro de auditoría: toda visualización de datos agregados de grupo,
// toda alerta consultada y toda exportación queda registrada aquí, para
// cumplir con los requisitos de trazabilidad de RGPD/LOPD-GDD.
model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String
  actorId    String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  school School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor  StaffUser @relation(fields: [actorId], references: [id])

  @@index([schoolId, createdAt])
}

// ── CHAT PÚBLICO (soytara.com/chat) ──────────────────────────────────────
// Usuarios anónimos del chat público, fuera de cualquier centro educativo.
// Se identifican solo por el código pseudónimo que ellos mismos eligen
// (equivalente al "alias" de Student, pero sin centro/grupo/consentimiento
// familiar porque no hay ninguno). Igual que en el resto del esquema, nunca
// se guarda aquí texto literal de conversación.
model PublicVisitor {
  id        String   @id @default(cuid())
  codi      String   @unique
  lang      String
  createdAt DateTime @default(now())

  usageSummaries PublicUsageSummary[]
  safetyAlerts   PublicSafetyAlert[]
}

model PublicUsageSummary {
  id         String   @id @default(cuid())
  visitorId  String
  mode       String // normal | empatia | mediacio
  sentiment  String?
  necessitat String?
  tornCount  Int      @default(0)
  createdAt  DateTime @default(now())

  visitor PublicVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([visitorId, createdAt])
}

// Alerta de seguridad activada por Tara en el chat público. "category" es
// la categoría anonimizada del protocolo de seguridad (ver SEGURETAT en el
// system prompt), nunca una cita literal. "identityHint" solo existe si
// la propia persona ofreció voluntariamente cómo identificarse ante un
// adulto de confianza — es el único campo potencialmente identificable de
// todo este bloque, y por eso se trata como el dato más sensible del panel.
model PublicSafetyAlert {
  id                 String        @id @default(cuid())
  visitorId          String
  severity           AlertSeverity
  status             AlertStatus   @default(OPEN)
  category           String
  identityHint       String?
  assignedReferentId String?
  createdAt          DateTime      @default(now())
  resolvedAt         DateTime?

  visitor          PublicVisitor           @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  assignedReferent StaffUser?              @relation("AssignedPublicAlert", fields: [assignedReferentId], references: [id])
  notes            PublicSafetyAlertNote[]

  @@index([status])
}

model PublicSafetyAlertNote {
  id        String   @id @default(cuid())
  alertId   String
  authorId  String
  text      String
  createdAt DateTime @default(now())

  alert  PublicSafetyAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  author StaffUser         @relation("PublicAlertNoteAuthor", fields: [authorId], references: [id])
}
