# Base de datos Postgres (proyecto y base de datos propios, separados de
# Tara-professionals — no se comparte infraestructura entre ambas apps).
DATABASE_URL="postgresql://user:password@host:5432/tara_schools?schema=public"

# NextAuth
NEXTAUTH_SECRET="genera uno con: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Envío de correo (recordatorios de consentimiento familiar a las tutorías).
# Si se dejan sin configurar, el panel de tutoría lo indica honestamente
# en vez de simular un envío que no ha ocurrido.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
